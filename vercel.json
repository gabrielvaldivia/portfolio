{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/activity/digest",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/notes/publish-scheduled",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/engagement-models/notifications",
      "schedule": "*/5 * * * *"
    }
  ],
  "fluid": true,
  "git": {
    "deploymentEnabled": {
      "master": true,
      "**": false
    }
  }
}
