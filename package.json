{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "test:highlights": "tsx --test tests/note-highlights.test.ts",
    "test:highlight-activity": "tsx --test tests/note-highlight-activity.test.ts",
    "test:highlight-attribution": "tsx --test tests/note-highlight-attribution.test.ts",
    "test:bottom-sheet": "tsx --test tests/bottom-sheet.test.ts",
    "test:views": "tsx --test tests/note-views.test.ts",
    "dev": "next dev",
    "build": "next build",
    "build:with-migrations": "npm run migrate && next build",
    "start": "next start",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "postinstall": "node scripts/patch-payload-bulk-upload.mjs",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@highlighters/core": "^2.0.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/translations": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "d3-geo": "^3.1.1",
    "exif-reader": "^2.0.3",
    "graphql": "^16.14.2",
    "lexical": "^0.41.0",
    "lucide-react": "^1.24.0",
    "mapbox-gl": "^3.26.0",
    "motion": "^12.42.2",
    "next": "^16.3.4",
    "payload": "^3.88.0",
    "qs-esm": "^8.0.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "resend": "^6.17.2",
    "sharp": "^0.35.4",
    "topojson-client": "^3.1.0",
    "tz-lookup": "^6.1.25",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "agentation": "^3.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "postcss": "^8.5.28",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.1",
    "@payloadcms/next": {
      "sass": {
        "immutable": "4.3.9"
      }
    },
    "sass": {
      ".": "$sass",
      "immutable": "5.1.8"
    }
  }
}
